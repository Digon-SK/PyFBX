from collections.abc import Iterator
from typing import Any, TypeAlias

Vec2: TypeAlias = tuple[float, float]
Vec3: TypeAlias = tuple[float, float, float]
Vec4: TypeAlias = tuple[float, float, float, float]
Matrix4: TypeAlias = tuple[Vec4, Vec4, Vec4, Vec4]
Transform: TypeAlias = dict[str, Vec3 | Vec4]
MaterialMap: TypeAlias = dict[str, Any]
ReadableBuffer: TypeAlias = bytes | bytearray | memoryview

__ufbx_version__: tuple[int, int, int]
__thread_safe__: bool


class Property:
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> str: ...
    @property
    def value(self) -> bool | int | float | str | bytes | Vec3 | Vec4 | None: ...
    @property
    def is_user_defined(self) -> bool: ...
    @property
    def is_animatable(self) -> bool: ...


class Camera:
    @property
    def name(self) -> str: ...
    @property
    def projection(self) -> str: ...
    @property
    def resolution(self) -> Vec2: ...
    @property
    def field_of_view(self) -> Vec2: ...
    @property
    def orthographic_size(self) -> Vec2: ...
    @property
    def aspect_ratio(self) -> float: ...
    @property
    def near_plane(self) -> float: ...
    @property
    def far_plane(self) -> float: ...
    @property
    def focal_length_mm(self) -> float: ...
    @property
    def properties(self) -> tuple[Property, ...]: ...
    def find_property(self, name: str) -> Property | None: ...


