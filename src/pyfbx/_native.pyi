    @property
    def geometry_transform(self) -> Transform: ...
    @property
    def node_to_world(self) -> Matrix4: ...
    @property
    def geometry_to_world(self) -> Matrix4: ...
    @property
    def properties(self) -> tuple[Property, ...]: ...
    def find_property(self, name: str) -> Property | None: ...
    def find(self, name: str) -> Node | None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Node]: ...


class Scene:
    @property
    def root(self) -> Node: ...
    @property
    def nodes(self) -> tuple[Node, ...]: ...
    @property
    def meshes(self) -> tuple[Mesh, ...]: ...
    @property
    def materials(self) -> tuple[Material, ...]: ...
    @property
    def textures(self) -> tuple[Texture, ...]: ...
    @property
    def animations(self) -> tuple[AnimationStack, ...]: ...
    @property
    def animation_curves(self) -> tuple[AnimationCurve, ...]: ...
    @property
    def cameras(self) -> tuple[Camera, ...]: ...
    @property
    def lights(self) -> tuple[Light, ...]: ...
    @property
    def bones(self) -> tuple[Bone, ...]: ...
    @property
    def elements(self) -> tuple[Element, ...]: ...
    @property
    def nurbs_curves(self) -> tuple[NurbsCurve, ...]: ...
    @property
    def nurbs_surfaces(self) -> tuple[NurbsSurface, ...]: ...
    def elements_of_type(self, type: str) -> tuple[Element, ...]: ...
    @property
    def warnings(self) -> tuple[dict[str, Any], ...]: ...
    @property
    def filename(self) -> str: ...
    @property
    def creator(self) -> str: ...
    @property
    def file_format(self) -> str: ...
    @property
    def file_version(self) -> int: ...
    @property
    def is_ascii(self) -> bool: ...
    @property
    def unit_meters(self) -> float: ...
    @property
    def frames_per_second(self) -> float: ...
    @property
    def memory_used(self) -> int: ...
    def find_node(self, name: str) -> Node | None: ...
    def evaluate(
        self,
        time: float,
        animation: AnimationStack | None = None,
        evaluate_skinning: bool = True,
    ) -> Scene: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Node]: ...
    def __getitem__(self, key: int | str) -> Node: ...


def load(filename: str, options: dict[str, object]) -> Scene: ...
def loads(data: ReadableBuffer, filename: str, options: dict[str, object]) -> Scene: ...
